# katagiri-agent environment. Copy this file to `.env` and fill in real
# values. `.env` is gitignored; this file is committed and MUST NEVER hold a
# real secret, token, or key -- every value below is a placeholder or blank.

# --- Windows console / subprocess encoding -------------------------------
# Set for the agent's own process. The katagiri and (stdio-variant) Obsidian
# subprocess env dicts set this independently in config.py, since a spawned
# child does not inherit python-dotenv's effect on this process.
PYTHONUTF8=1

# --- katagiri connection (stdio only) ------------------------------------
# Path to the Python interpreter that has katagiri installed. agent/ and the
# primary katagiri checkout are separate uv projects with separate venvs, so
# this must point at the PRIMARY checkout's venv, e.g.
# <path-to-katagiri-checkout>/.venv/Scripts/python.exe (Windows) or
# <path-to-katagiri-checkout>/.venv/bin/python (macOS/Linux).
KATAGIRI_PYTHON=
# Module to run as `python -m <module>` (matches katagiri's mcp_server entry
# point). Leave at the default unless katagiri's entry point moves.
KATAGIRI_MODULE=katagiri.mcp_server
# Optional: additive config-path override for the demo profile (see
# src/katagiri/config.py's KATAGIRI_CONFIG support, added in TG-B). Leave
# unset to use the operator's normal %LOCALAPPDATA%\Katagiri config.
KATAGIRI_CONFIG=

# --- Obsidian Local REST API connection (swappable transport) -----------
# "streamable_http" (the plugin's built-in /mcp/ endpoint) or "stdio" (a
# wrapper). See specs/005-mcp-assignment/research.md, "Open, deliberately",
# for why this is still open at the time this file was written.
OBSIDIAN_TRANSPORT=streamable_http

# streamable_http settings (used when OBSIDIAN_TRANSPORT=streamable_http)
OBSIDIAN_MCP_URL=https://127.0.0.1:27124/mcp/
OBSIDIAN_API_TOKEN=
# Set to false only for the demo vault's self-signed cert; never for a
# personal-vault connection. Never left implicitly false.
OBSIDIAN_VERIFY_TLS=true
# Alternative to disabling verification entirely: point at a CA bundle /
# exported cert file that validates the demo vault's self-signed cert.
OBSIDIAN_CA_BUNDLE=

# stdio settings (used when OBSIDIAN_TRANSPORT=stdio)
OBSIDIAN_STDIO_COMMAND=
OBSIDIAN_STDIO_ARGS=

# --- Model layer ----------------------------------------------------------
# OpenRouter API key. The free tier's 50 requests/day is not enough headroom
# for a real study session -- top up if you hit rate limits.
OPENROUTER_API_KEY=
# Pinned model id, chosen at T012 from models verified to emit tool calls.
# See "Client + model layer (T012)" in agent/README.md for the reasoning.
# Never left unpinned or handed to OpenRouter's default/auto routing -- an
# unpinned model that cannot emit tool calls is an unrecoverable defence
# failure (spec.md FR-007).
OPENROUTER_MODEL=openai/gpt-4o-mini
