# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Python
__pycache__/
.venv/
*.egg-info/
.pytest_cache/
dist/

# Vendored dictionaries/data: binaries stay local, docs + checksums are committed.
vendor/*
!vendor/README.md
!vendor/CHECKSUMS.sha256

# Tae Kim's Guide to Japanese Grammar (CC BY-NC-SA, committable with
# attribution -- see vendor/README.md): unlike everything else under vendor/,
# these extracts are allowed to be tracked, so un-ignore the directory.
!vendor/taekim/
!vendor/taekim/**

# Irodori (Japan Foundation) intentionally has no matching negation: custom
# terms forbid redistribution, so its PDF/MP3 files must stay covered by the
# vendor/* rule above and never be committed, under any circumstance.

# Test-suite JMdict template cache
tests/.cache/

# Local test-run transcripts
test-run*.log

# agent/ (005-mcp-assignment): separate uv subproject, own secrets and venv
agent/.env
agent/.venv/
agent/**/checkpoints.sqlite
agent/**/checkpoints.sqlite-*
agent/scratch/
agent/run-transcripts/
agent/*.log
